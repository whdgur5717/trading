{
  "name": "trading-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Trading application workspace",
  "scripts": {
    "generate:openapi": "pnpm --dir back generate:openapi && oxfmt packages/api-client/openapi.json",
    "generate:api": "api-client generate front && oxfmt front/src/queries/generated",
    "prepare:api": "pnpm generate:openapi && pnpm generate:api",
    "build": "pnpm prepare:api && turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "pnpm prepare:api && turbo run type-check",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@trading/api-client": "workspace:*",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "oxfmt": "^0.64.0",
    "turbo": "^2.10.0"
  }
}
